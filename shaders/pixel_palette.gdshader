shader_type canvas_item;
// 도트 후처리: 640×360 화면을 고정 팔레트(34색)로 줄이고, 그라데이션·빛 번짐은 4×4 정렬 디더링으로 표현한다.
// 색 언어는 그대로: 청백 = 나, 금 = 패리 가능, 주황 = 공격, 빨강 = 위험, 검붉은 보라 = 패리 불가, 민트 = 퍼펙트 회피.

uniform sampler2D screen_tex : hint_screen_texture, filter_nearest;
uniform float dither_spread = 0.07;

const int N = 34;
const vec3 PAL[N] = vec3[N](
	// 배경·몸체 (차가운 어둠)
	vec3(0.027, 0.035, 0.051), vec3(0.051, 0.067, 0.094), vec3(0.082, 0.102, 0.137), vec3(0.118, 0.145, 0.188),
	vec3(0.161, 0.200, 0.255), vec3(0.231, 0.282, 0.349), vec3(0.329, 0.388, 0.463), vec3(0.471, 0.525, 0.596),
	// 강철·뼈·흰색
	vec3(0.659, 0.698, 0.749), vec3(0.851, 0.875, 0.906), vec3(0.973, 0.980, 0.988), vec3(0.784, 0.749, 0.659),
	// 청백 (플레이어)
	vec3(0.165, 0.420, 0.690), vec3(0.392, 0.733, 0.980), vec3(0.749, 0.902, 1.000),
	// 민트 (퍼펙트 회피)
	vec3(0.180, 0.780, 0.620), vec3(0.600, 1.000, 0.880),
	// 금 (패리 가능)
	vec3(0.560, 0.380, 0.090), vec3(0.890, 0.680, 0.160), vec3(1.000, 0.870, 0.420), vec3(1.000, 0.960, 0.760),
	// 용암·주황 (공격)
	vec3(0.200, 0.040, 0.030), vec3(0.420, 0.090, 0.040), vec3(0.760, 0.240, 0.070), vec3(1.000, 0.420, 0.140),
	vec3(1.000, 0.640, 0.330),
	// 빨강 (위험)
	vec3(0.330, 0.050, 0.060), vec3(0.500, 0.080, 0.090), vec3(0.690, 0.110, 0.130), vec3(1.000, 0.330, 0.300),
	// 검붉은 보라 (패리 불가)
	vec3(0.300, 0.040, 0.200), vec3(0.600, 0.080, 0.380), vec3(0.900, 0.400, 0.720),
	// 핏빛 어둠 (코어 빈 공간)
	vec3(0.130, 0.030, 0.050)
);

const float BAYER[16] = float[16](
	0.0, 8.0, 2.0, 10.0,
	12.0, 4.0, 14.0, 6.0,
	3.0, 11.0, 1.0, 9.0,
	15.0, 7.0, 13.0, 5.0
);

void fragment() {
	vec3 c = texture(screen_tex, SCREEN_UV).rgb;
	ivec2 px = ivec2(FRAGCOORD.xy) % 4;
	float th = (BAYER[px.y * 4 + px.x] + 0.5) / 16.0 - 0.5;
	c += th * dither_spread;
	float best = 1e9;
	vec3 pick = PAL[0];
	for (int i = 0; i < N; i++) {
		vec3 d = (c - PAL[i]) * vec3(0.9, 1.2, 0.7);    // 사람 눈 밝기 감도에 맞춘 가중치
		float e = dot(d, d);
		if (e < best) {
			best = e;
			pick = PAL[i];
		}
	}
	COLOR = vec4(pick, 1.0);
}
